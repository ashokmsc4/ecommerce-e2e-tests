# Copy to .env and fill in. Never commit .env.
BASE_URL=https://tasawoq.uat.aawweb.com

# Optional HTTP basic auth if the UAT is protected
HTTP_USERNAME=
HTTP_PASSWORD=

# Existing UAT customer for login / account tests (tests skip when empty)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Search term known to return results, and one that should return none
SEARCH_TERM=shampoo
SEARCH_TERM_NO_RESULTS=zzqxnotaproduct123

# Optional: direct product URL path to use instead of discovering one from search
PRODUCT_PATH=

# Set to false to skip tests that create a new customer account on UAT
ALLOW_REGISTRATION=true
